{
  "name": "HabiStride",
  "short_name": "HabiStride",
  "description": "A local-first habit tracker with flexible schedules, notes, insights and calendar reminders.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f6f8",
  "theme_color": "#5e6ad2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
